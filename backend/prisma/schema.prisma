generator client {
  provider     = "prisma-client-js"
  moduleFormat = "cjs"
  engineType   = "library"
}

datasource db {
  provider = "postgresql"
}

model chat_messages {
  message_id Int         @id @default(autoincrement())
  room_id    Int
  user_id    Int
  message    String
  file_path  String?     @db.VarChar
  created_at DateTime    @default(now()) @db.Timestamp(6)
  updated_at DateTime?   @updatedAt @db.Timestamp(6)
  chat_rooms chat_rooms? @relation(fields: [room_id], references: [room_id], onDelete: NoAction, onUpdate: NoAction)
  users      users?      @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([room_id, created_at])
}

model chat_room_users {
  room_id    Int
  user_id    Int
  joined_at  DateTime   @default(now()) @db.Timestamp(6)
  left_at    DateTime?  @db.Timestamp(6)
  chat_rooms chat_rooms @relation(fields: [room_id], references: [room_id], onDelete: NoAction, onUpdate: NoAction)
  users      users      @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)

  @@id([room_id, user_id, joined_at])
  @@index([user_id])
}

model chat_rooms {
  room_id          Int               @id @default(autoincrement())
  name             String?           @db.VarChar
  task_id          Int?
  class_id         Int?
  is_private       Boolean           @default(false)
  direct_chat_hash String?           @unique @db.VarChar(50)
  created_by       Int
  created_at       DateTime          @default(now()) @db.Timestamp(6)
  updated_at       DateTime?         @updatedAt @db.Timestamp(6)
  chat_messages    chat_messages[]
  chat_room_users  chat_room_users[]
  classes          classes?          @relation(fields: [class_id], references: [class_id], onDelete: NoAction, onUpdate: NoAction)
  tasks            tasks?            @relation(fields: [task_id], references: [task_id], onDelete: NoAction, onUpdate: NoAction)
  users            users?            @relation("chat_rooms_created", fields: [created_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
}

model classes {
  class_id         Int                @id @default(autoincrement())
  name             String?            @db.VarChar
  department_id    Int?
  head_teacher_id  Int?
  schedule_id      Int?
  created_at       DateTime?          @default(now()) @db.Timestamp(6)
  updated_at       DateTime?          @db.Timestamp(6)
  chat_rooms       chat_rooms[]
  departments      departments?       @relation(fields: [department_id], references: [department_id], onDelete: NoAction, onUpdate: NoAction)
  teachers         teachers?          @relation(fields: [head_teacher_id], references: [teacher_id], onDelete: NoAction, onUpdate: NoAction)
  schedules        schedules?         @relation(fields: [schedule_id], references: [schedule_id], onDelete: NoAction, onUpdate: NoAction)
  classes_teachers classes_teachers[]
  students         students[]
}

model classes_teachers {
  class_id    Int
  teacher_id  Int
  assigned_at DateTime? @default(now()) @db.Timestamp(6)
  classes     classes   @relation(fields: [class_id], references: [class_id], onDelete: NoAction, onUpdate: NoAction)
  teachers    teachers  @relation(fields: [teacher_id], references: [teacher_id], onDelete: NoAction, onUpdate: NoAction)

  @@id([class_id, teacher_id])
}

model departments {
  department_id Int       @id @default(autoincrement())
  name          String?   @db.VarChar
  created_at    DateTime? @default(now()) @db.Timestamp(6)
  updated_at    DateTime? @db.Timestamp(6)
  classes       classes[]
}

model document_shares {
  document_id Int
  user_id     Int
  created_at  DateTime? @default(now()) @db.Timestamp(6)
  documents   documents @relation(fields: [document_id], references: [document_id], onDelete: NoAction, onUpdate: NoAction)
  users       users     @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)

  @@id([document_id, user_id])
}

model documents {
  document_id     Int               @id @default(autoincrement())
  name            String?           @db.VarChar
  file_path       String?           @db.VarChar
  file_blob       Bytes?
  file_size       Int?
  mime_type       String?           @db.VarChar
  added_by        Int?
  grade           String?           @db.VarChar
  feedback        String?
  graded_by       Int?
  graded_at       DateTime?         @db.Timestamp(6)
  created_at      DateTime?         @default(now()) @db.Timestamp(6)
  updated_at      DateTime?         @db.Timestamp(6)
  document_shares document_shares[]
  graded_by_user  users?            @relation("documents_graded_by", fields: [graded_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  users           users?            @relation(fields: [added_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  note_documents  note_documents[]
  task_documents  task_documents[]
}

model lesson_slots {
  slot_id       Int        @id @default(autoincrement())
  schedule_id   Int?
  subject_id    Int?
  teacher_id    Int?
  room_id       Int?
  day_of_week   Int?
  lesson_number Int?
  start_time    DateTime?  @db.Time(6)
  end_time      DateTime?  @db.Time(6)
  created_at    DateTime?  @default(now()) @db.Timestamp(6)
  updated_at    DateTime?  @db.Timestamp(6)
  rooms         rooms?     @relation(fields: [room_id], references: [room_id], onDelete: NoAction, onUpdate: NoAction)
  schedules     schedules? @relation(fields: [schedule_id], references: [schedule_id], onDelete: NoAction, onUpdate: NoAction)
  subjects      subjects?  @relation(fields: [subject_id], references: [subject_id], onDelete: NoAction, onUpdate: NoAction)
  teachers      teachers?  @relation(fields: [teacher_id], references: [teacher_id], onDelete: NoAction, onUpdate: NoAction)
}

model note_documents {
  note_id     Int
  document_id Int
  created_at  DateTime? @default(now()) @db.Timestamp(6)
  documents   documents @relation(fields: [document_id], references: [document_id], onDelete: NoAction, onUpdate: NoAction)
  notes       notes     @relation(fields: [note_id], references: [note_id], onDelete: NoAction, onUpdate: NoAction)

  @@id([note_id, document_id])
}

model notes {
  note_id        Int              @id @default(autoincrement())
  title          String?          @db.VarChar
  created_by     Int?
  description    String?
  subject_id     Int?
  priority_id    Int?
  created_at     DateTime?        @default(now()) @db.Timestamp(6)
  updated_at     DateTime?        @db.Timestamp(6)
  note_documents note_documents[]
  users          users?           @relation(fields: [created_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  priorities     priorities?      @relation(fields: [priority_id], references: [priority_id], onDelete: NoAction, onUpdate: NoAction)
  subjects       subjects?        @relation(fields: [subject_id], references: [subject_id], onDelete: NoAction, onUpdate: NoAction)
  notes_users    notes_users[]
}

model comments {
  comment_id Int       @id @default(autoincrement())
  task_id    Int?
  created_by Int?
  content    String?
  created_at DateTime? @default(now()) @db.Timestamp(6)
  updated_at DateTime? @db.Timestamp(6)
  users      users?    @relation(fields: [created_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  tasks      tasks?    @relation(fields: [task_id], references: [task_id], onDelete: NoAction, onUpdate: NoAction)
}

model notes_users {
  note_id    Int
  user_id    Int
  created_at DateTime? @default(now()) @db.Timestamp(6)
  notes      notes     @relation(fields: [note_id], references: [note_id], onDelete: NoAction, onUpdate: NoAction)
  users      users     @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)

  @@id([note_id, user_id])
}

model notifications {
  notification_id Int       @id @default(autoincrement())
  user_id         Int?
  type            String?   @db.VarChar
  text            String?   @db.VarChar
  created_at      DateTime? @default(now()) @db.Timestamp(6)
  is_read         Boolean?  @default(false)
  users           users?    @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([user_id, created_at])
}

model permissions {
  permission_id     Int                 @id @default(autoincrement())
  name              String              @db.VarChar // z.B. 'create_task', 'edit_grades'
  description       String?
  flags             Int                 @default(7) // 4=READ, 2=WRITE, 1=EXECUTE (7=RWX)
  created_at        DateTime?           @default(now()) @db.Timestamp(6)
  updated_at        DateTime?           @updatedAt @db.Timestamp(6)
  roles_permissions roles_permissions[]
  user_permissions  user_permissions[]
}

model priorities {
  priority_id Int       @id @default(autoincrement())
  name        String?
  created_at  DateTime? @default(now()) @db.Timestamp(6)
  updated_at  DateTime? @db.Timestamp(6)
  notes       notes[]
  tasks       tasks[]
}

model roles {
  role_id           Int                 @id @default(autoincrement())
  name              String?             @db.VarChar
  roles_permissions roles_permissions[]
  user_roles        user_roles[]
}

model roles_permissions {
  roles_id      Int
  permission_id Int
  assigned_at   DateTime?   @default(now()) @db.Timestamp(6)
  permissions   permissions @relation(fields: [permission_id], references: [permission_id], onDelete: NoAction, onUpdate: NoAction)
  roles         roles       @relation(fields: [roles_id], references: [role_id], onDelete: NoAction, onUpdate: NoAction)

  @@id([roles_id, permission_id])
}

model rooms {
  room_id      Int            @id @default(autoincrement())
  name         String?        @db.VarChar
  type         String?        @db.VarChar
  capacity     Int?
  building     String?        @db.VarChar
  created_at   DateTime?      @default(now()) @db.Timestamp(6)
  updated_at   DateTime?      @db.Timestamp(6)
  lesson_slots lesson_slots[]
}

model schedules {
  schedule_id  Int            @id @default(autoincrement())
  name         String?        @db.VarChar
  valid_from   DateTime?      @db.Date
  valid_to     DateTime?      @db.Date
  created_at   DateTime?      @default(now()) @db.Timestamp(6)
  updated_at   DateTime?      @db.Timestamp(6)
  classes      classes[]
  lesson_slots lesson_slots[]
}

model students {
  student_id Int       @id
  class_id   Int?
  updated_at DateTime? @db.Timestamp(6)
  classes    classes?  @relation(fields: [class_id], references: [class_id], onDelete: NoAction, onUpdate: NoAction)
  users      users     @relation(fields: [student_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
}

model subjects {
  subject_id   Int            @id @default(autoincrement())
  name         String?        @db.VarChar
  short_name   String?        @db.VarChar
  created_at   DateTime?      @default(now()) @db.Timestamp(6)
  updated_at   DateTime?      @db.Timestamp(6)
  lesson_slots lesson_slots[]
  notes        notes[]
}

model task_activity_log {
  log_id    Int       @id @default(autoincrement())
  task_id   Int?
  user_id   Int?
  action    String?   @db.VarChar
  timestamp DateTime? @default(now()) @db.Timestamp(6)
  tasks     tasks?    @relation(fields: [task_id], references: [task_id], onDelete: NoAction, onUpdate: NoAction)
  users     users?    @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([task_id])
}

/// Teachers' grading remarks on a task (decision Q16, M15); discussion comments are in `comments`.
model task_grade {
  comment_id Int       @id @default(autoincrement())
  task_id    Int?
  user_id    Int?
  text       String?
  created_at DateTime? @default(now()) @db.Timestamp(6)
  updated_at DateTime? @db.Timestamp(6)
  tasks      tasks?    @relation(fields: [task_id], references: [task_id], onDelete: NoAction, onUpdate: NoAction)
  users      users?    @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
}

model task_documents {
  task_id     Int
  document_id Int
  created_at  DateTime? @default(now()) @db.Timestamp(6)
  documents   documents @relation(fields: [document_id], references: [document_id], onDelete: NoAction, onUpdate: NoAction)
  tasks       tasks     @relation(fields: [task_id], references: [task_id], onDelete: NoAction, onUpdate: NoAction)

  @@id([task_id, document_id])
}

model task_members {
  task_id   Int
  user_id   Int
  joined_at DateTime @default(now()) @db.Timestamp(6)
  // the member's rights on the task (T99, decision I4, M38): 4 = READ (see
  // the members), 2 = WRITE (add and remove them), 1 = EXECUTE (change flags)
  flags     Int      @default(4)

  tasks tasks @relation(fields: [task_id], references: [task_id], onDelete: Cascade)
  users users @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@id([task_id, user_id])
  @@index([user_id])
}

model task_templates {
  template_id Int       @id @default(autoincrement())
  created_by  Int
  name        String?   @db.VarChar
  description String?
  created_at  DateTime? @default(now()) @db.Timestamp(6)
  updated_at  DateTime? @db.Timestamp(6)
  user        users     @relation(fields: [created_by], references: [user_id])
  tasks       tasks[]
}

model tasks {
  task_id                        Int                 @id @default(autoincrement())
  parent_task_id                 Int?
  title                          String?             @db.VarChar
  description                    String?
  status                         task_status?        @default(TODO)
  progress                       Int?
  deadline                       DateTime?           @db.Timestamp(6)
  /// T101 (decision Q20, M33): every task has a creator; deleted accounts' tasks go to the ghost user 0
  created_by                     Int
  assigned_to                    Int?
  template_id                    Int?
  priority_id                    Int?
  completion_rule                Json?
  auto_complete                  Boolean?
  is_locked                      Boolean?            @default(false)
  locked_reason                  String?             @db.VarChar
  locked_until                   DateTime?           @db.Timestamp(6)
  created_at                     DateTime?           @default(now()) @db.Timestamp(6)
  updated_at                     DateTime?           @updatedAt @db.Timestamp(6)
  chat_rooms                     chat_rooms[]
  task_activity_log              task_activity_log[]
  task_grade                     task_grade[]
  task_tags                      task_tags[]
  task_documents                 task_documents[]
  task_members                   task_members[]
  comments                       comments[]
  users_tasks_assigned_toTousers users?              @relation("tasks_assigned_toTousers", fields: [assigned_to], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  users_tasks_created_byTousers  users               @relation("tasks_created_byTousers", fields: [created_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  tasks                          tasks?              @relation("tasksTotasks", fields: [parent_task_id], references: [task_id], onDelete: NoAction, onUpdate: NoAction)
  other_tasks                    tasks[]             @relation("tasksTotasks")
  priorities                     priorities?         @relation(fields: [priority_id], references: [priority_id], onDelete: NoAction, onUpdate: NoAction)
  task_templates                 task_templates?     @relation(fields: [template_id], references: [template_id], onDelete: NoAction, onUpdate: NoAction)

  // M30 (T87, decision Q8h): the joins and filters of the main queries
  @@index([parent_task_id])
  @@index([created_by])
  @@index([assigned_to])
}

model teachers {
  teacher_id                          Int                @id
  supervisor_id                       Int?
  updated_at                          DateTime?          @db.Timestamp(6)
  classes                             classes[]
  classes_teachers                    classes_teachers[]
  lesson_slots                        lesson_slots[]
  users_teachers_supervisor_idTousers users?             @relation("teachers_supervisor_idTousers", fields: [supervisor_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  users_teachers_teacher_idTousers    users              @relation("teachers_teacher_idTousers", fields: [teacher_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
}

model user_permissions {
  user_id       Int
  permission_id Int
  valid_from    DateTime?   @default(now()) @db.Timestamp(6) // Wann die Permission startet
  valid_to      DateTime?   @db.Timestamp(6) // Wann die Permission ENDET (null=unbegrenzt)
  assigned_at   DateTime?   @default(now()) @db.Timestamp(6)
  permissions   permissions @relation(fields: [permission_id], references: [permission_id], onDelete: Cascade, onUpdate: NoAction)
  users         users       @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)

  @@id([user_id, permission_id])
  @@index([valid_from, valid_to]) // Für schnelle Zeitabfragen
}

model user_roles {
  user_id     Int
  role_id     Int
  assigned_at DateTime? @default(now()) @db.Timestamp(6)
  roles       roles     @relation(fields: [role_id], references: [role_id], onDelete: NoAction, onUpdate: NoAction)
  users       users     @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)

  @@id([user_id, role_id])
}

enum user_role {
  Superuser
  Admin
  Teacher
  Student
}

model users {
  user_id                                Int                 @id @default(autoincrement())
  firstname                              String              @db.VarChar
  lastname                               String              @db.VarChar
  email                                  String              @unique @db.VarChar
  username                               String              @unique @db.VarChar
  password_hash                          String?             @db.VarChar
  google_id                              String?             @unique @db.VarChar
  created_at                             DateTime?           @default(now()) @db.Timestamp(6)
  updated_at                             DateTime?           @updatedAt @db.Timestamp(6)
  chat_messages                          chat_messages[]
  chat_room_users                        chat_room_users[]
  document_shares                        document_shares[]
  documents                              documents[]
  graded_documents                       documents[]         @relation("documents_graded_by")
  notes                                  notes[]
  notes_users                            notes_users[]
  notifications                          notifications[]
  comments                               comments[]
  email_preferences                      email_preferences?
  email_logs                             email_logs[]
  students                               students?
  task_activity_log                      task_activity_log[]
  task_grade                             task_grade[]
  tasks_tasks_assigned_toTousers         tasks[]             @relation("tasks_assigned_toTousers")
  tasks_tasks_created_byTousers          tasks[]             @relation("tasks_created_byTousers")
  teachers_teachers_supervisor_idTousers teachers[]          @relation("teachers_supervisor_idTousers")
  teachers_teachers_teacher_idTousers    teachers?           @relation("teachers_teacher_idTousers")
  user_permissions                       user_permissions[]
  user_roles                             user_roles[]
  taskTemplates                          task_templates[]
  task_members                           task_members[]
  chat_rooms_created                     chat_rooms[]        @relation("chat_rooms_created")
  refresh_tokens                         refresh_tokens[]
  user_two_factor                        user_two_factor?
  user_settings                          user_settings?
  user_avatars                           user_avatars?
}

model email_preferences {
  preference_id     Int       @id @default(autoincrement())
  user_id           Int       @unique
  email_on_deadline Boolean   @default(true)
  email_on_mention  Boolean   @default(true)
  email_on_comment  Boolean   @default(true)
  email_digest      Boolean   @default(false)
  digest_frequency  String    @default("daily") @db.VarChar // daily, weekly, monthly
  created_at        DateTime? @default(now()) @db.Timestamp(6)
  updated_at        DateTime? @updatedAt @db.Timestamp(6)
  users             users     @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
}

model email_logs {
  email_log_id  Int       @id @default(autoincrement())
  user_id       Int
  recipient     String    @db.VarChar
  subject       String    @db.VarChar
  email_type    String    @db.VarChar // 'deadline', 'mention', 'comment', 'digest'
  status        String    @default("sent") @db.VarChar // 'sent', 'failed', 'pending'
  error_message String?   @db.Text
  sent_at       DateTime? @db.Timestamp(6)
  created_at    DateTime? @default(now()) @db.Timestamp(6)
  users         users     @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
}

enum task_status {
  TODO
  IN_PROGRESS
  IN_REVIEW
  ON_HOLD
  COMPLETED
}

/// One login session (decision Q8b, T51): only the SHA-256 hash of the refresh
/// token is stored; refresh rotates it (revoked_at set, new row), logout revokes it.
/// T31 (decision Q8d, M32): the user's TOTP secret, encrypted with
/// TWO_FACTOR_ENCRYPTION_KEY; enabled_at is null until the first code confirms
/// the setup. An admin reset deletes the row; deleting the user deletes it.
model user_two_factor {
  user_id          Int       @id
  secret_encrypted String    @db.VarChar
  enabled_at       DateTime? @db.Timestamp(6)
  users            users     @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
}

/// T68 (decision Q8f, M25): the user's settings, stored on the server so they
/// follow the user to every device; theme is light, dark or system.
model user_settings {
  user_id Int    @id
  theme   String @default("light") @db.VarChar(10)
  users   users  @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
}

// the profile picture (T47, decision Q8c, M27): image bytes, at most 1 MB
model user_avatars {
  user_id    Int      @id
  mime_type  String   @db.VarChar(50)
  data       Bytes
  updated_at DateTime @default(now()) @db.Timestamp(6)
  users      users    @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
}

model refresh_tokens {
  id         Int       @id @default(autoincrement())
  user_id    Int
  token_hash String    @unique @db.VarChar(64)
  expires_at DateTime  @db.Timestamp(6)
  revoked_at DateTime? @db.Timestamp(6)
  users      users     @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@index([user_id])
}

/// Tags/labels on tasks (T59, FA-25, decision Q8e, M18)
model tags {
  tag_id    Int         @id @default(autoincrement())
  name      String      @unique @db.VarChar(50)
  task_tags task_tags[]
}

model task_tags {
  task_id Int
  tag_id  Int
  tasks   tasks @relation(fields: [task_id], references: [task_id], onDelete: Cascade)
  tags    tags  @relation(fields: [tag_id], references: [tag_id], onDelete: Cascade)

  @@id([task_id, tag_id])
  @@index([tag_id])
}
