# Environment for the E2E tests (GOALS.md M3). Only throwaway test values.
# The database is the disposable container from docker-compose.test.yml.
# test/setup/test-env.ts refuses to run against a database whose name
# doesn't end in "_test".
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/effsync_test?schema=public"

JWT_SECRET="e2e-test-secret-not-for-production"
# M32: encrypts the TOTP secrets; a throwaway test key
TWO_FACTOR_ENCRYPTION_KEY="00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff"
JWT_EXPIRATION="15m"

NODE_ENV=test
# The global ThrottlerGuard allows 10 requests/minute by default; a workflow
# test makes more. The explicit @Throttle limits on register/login (3/minute)
# still apply, which auth-throttle.e2e-spec.ts checks.
THROTTLE_LIMIT=1000
PORT=3001
FRONTEND_URL="http://localhost:5173"
APP_URL="http://localhost:5173"
UPLOAD_DIR="./uploads-test"

# NODE_ENV=test: the EmailService sends nothing and writes every mail as JSON
# into MAIL_OUTBOX_DIR (M13), where the password-reset E2E test reads the link.
MAIL_OUTBOX_DIR="./mail-outbox-test"
# Ethereal is used only in development; these values are never used in tests.
ETHEREAL_USER="e2e-test@ethereal.invalid"
ETHEREAL_PASSWORD="e2e-test"
EMAIL_FROM="\"EffSync Test\" <test@effsync.local>"

GOOGLE_CLIENT_ID="e2e-test-client-id"
GOOGLE_CLIENT_SECRET="e2e-test-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:3001/api/auth/google/callback"
