# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/effsync?schema=public"

# JWT Authentication
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRATION="15m"

# Server Configuration
PORT=3000
NODE_ENV=development

# Frontend Configuration (CORS, Redirects, Links in E-Mails)
FRONTEND_URL="http://localhost:5173"
APP_URL="http://localhost:5173"
# Production only: the https:// address of the backend behind the reverse
# proxy; plain-HTTP requests are redirected there (README)
# PUBLIC_URL="https://api.example.com"

# File Upload Configuration (max. Dateigröße ist im Code auf 25 MB festgelegt)
UPLOAD_DIR="./uploads"

# Email Configuration
# NODE_ENV=production: Versand über SMTP
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="your-email@example.com"
SMTP_PASSWORD="your-email-password"
EMAIL_FROM="\"EffSync\" <noreply@effsync.local>"
# NODE_ENV=development: Test-Versand über Ethereal (https://ethereal.email/)
ETHEREAL_USER="your-ethereal-user"
ETHEREAL_PASSWORD="your-ethereal-password"

# Google OAuth Configuration (https://console.cloud.google.com/), siehe documents/GOOGLE_OAUTH_SETUP.md
GOOGLE_CLIENT_ID="your_google_client_id_here"
GOOGLE_CLIENT_SECRET="your_google_client_secret_here"
GOOGLE_CALLBACK_URL="http://localhost:3000/api/auth/google/callback"
