{
  "name": "effsync",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "frontend": "vite --port 5173 --strictPort",
    "build": "vite build",
    "preview": "vite preview",
    "mockend": "npx json-server mockdb.json --port 3001",
    "dev": "concurrently 'npm run mockend' 'npm run frontend'",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "cypress run",
    "test:e2e:open": "cypress open",
    "lint": "eslint .",
    "lint:check": "eslint .",
    "knip": "knip",
    "lint:fix": "eslint --fix"
  },
  "dependencies": {
    "@popperjs/core": "^2.11.8",
    "axios": "^1.13.2",
    "bootstrap": "^5.3.8",
    "chart.js": "^4.5.1",
    "pinia": "^3.0.4",
    "sass": "^1.94.2",
    "socket.io-client": "^4.8.3",
    "vue": "^3.5.24",
    "vue-chartjs": "^5.3.3",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@testing-library/vue": "^8.1.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vitest/coverage-v8": "^4.0.17",
    "@vitest/ui": "^4.0.17",
    "@vue/test-utils": "^2.4.6",
    "axios-mock-adapter": "^2.1.0",
    "concurrently": "^9.2.1",
    "cypress": "^15.9.0",
    "eslint": "^9.39.2",
    "eslint-plugin-cypress": "^5.2.1",
    "eslint-plugin-vue": "^10.7.0",
    "globals": "^17.0.0",
    "jsdom": "^27.4.0",
    "json-server": "^1.0.0-beta.3",
    "knip": "5.88.1",
    "vite": "^7.2.4",
    "vitest": "^4.0.17"
  }
}
