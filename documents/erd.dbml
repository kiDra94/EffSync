Table users {
  user_id integer [pk]
  firstname varchar
  lastname varchar
  email varchar [unique]
  username varchar [unique]
  password_hash varchar
  created_at datetime [default: `now()`]
}

Table roles {
  role_id integer [pk]
  name varchar // 'Admin', 'Lehrer', 'Schüler'
}

Table permissions {
  permission_id integer [pk]
  name varchar // 'noten_eintragen', 'chat_erstellen'
}

Table role_permissions {
  role_id integer [ref: > roles.role_id]
  permission_id integer [ref: > permissions.permission_id]
  primary key (role_id, permission_id)
}

Table user_roles {
  user_id integer [ref: > users.user_id]
  role_id integer [ref: > roles.role_id]
  valid_from datetime [default: `now()`]
  valid_until datetime [null] 
  primary key (user_id, role_id)
}

Table user_permissions {
  user_permission_id integer [pk]
  user_id integer [ref: > users.user_id]
  permission_id integer [ref: > permissions.permission_id]
  granted_by integer [ref: > users.user_id]
  valid_from datetime [default: `now()`]
  valid_until datetime [null]
  reason varchar
}

Table task_statuses {
  status_id integer [pk]
  name varchar // 'Offen', 'In Arbeit', 'Erledigt'
  color_code varchar
  is_final boolean [default: false]
}

Table tasks {
  task_id integer [pk]
  parent_task_id integer [ref: > tasks.task_id]
  title varchar
  description text
  status_id integer [ref: > task_statuses.status_id] 
  progress integer [default: 0]
  deadline datetime
  created_by integer [ref: > users.user_id]
  assigned_to integer [ref: > users.user_id]
  created_at datetime [default: `now()`]
}

Table task_templates {
  template_id integer [pk]
  name varchar
  description text
}

Table task_comments {
  comment_id integer [pk]
  task_id integer [ref: > tasks.task_id]
  user_id integer [ref: > users.user_id]
  text text
  created_at datetime [default: `now()`]
}

Table task_activity_log {
  log_id integer [pk]
  task_id integer [ref: > tasks.task_id]
  user_id integer [ref: > users.user_id]
  action varchar
  created_at datetime [default: `now()`]
}

Table documents {
  document_id integer [pk]
  name varchar
  file_path varchar
  added_by integer [ref: > users.user_id]
  task_id integer [ref: > tasks.task_id]
}

Table document_users {
  document_id integer [ref: > documents.document_id]
  user_id integer [ref: > users.user_id]
  primary key (document_id, user_id)
}

Table notes {
  note_id integer [pk]
  description varchar
  created_by integer [ref: > users.user_id]
  note text
  subject_id integer [ref: > subjects.subject_id]
  document_id integer [ref: > documents.document_id]
  priority_id integer [ref: > priorities.priority_id]
  created_at datetime [default: `now()`]
}

Table priorities {
  priority_id integer [pk]
  name text
}

Table notes_users {
  note_id integer [ref: > notes.note_id]
  user_id integer [ref: > users.user_id]
  primary key (note_id, user_id)
}


Table departments {
  department_id integer [pk]
  name varchar
}

Table subjects {
  subject_id integer [pk]
  name varchar
}

Table schedules {
  schedule_id integer [pk]
  name varchar
  created_at datetime [default: `now()`]
}

Table timetable {
  item_id integer [pk]
  schedule_id integer [ref: > schedules.schedule_id]
  subject_id integer [ref: > subjects.subject_id]
  day_of_week integer // 0=Sonntag, 1=Montag, ..., 6=Samstag
  start_time time
  end_time time
  room varchar
}

Table classes {
  class_id integer [pk]
  name varchar
  department_id integer [ref: > departments.department_id]
  kv_id integer [ref: > teachers.teacher_id]
  schedule_id integer [ref: > schedules.schedule_id]
}

Table teachers {
  teacher_id integer [pk, ref: > users.user_id]
  supervisor_id integer [ref: > users.user_id]
}

Table students {
  student_id integer [pk, ref: > users.user_id]
  class_id integer [ref: > classes.class_id]
}

Table classes_teachers {
  class_id integer [ref: > classes.class_id]
  teacher_id integer [ref: > teachers.teacher_id]
  primary key (class_id, teacher_id)
}

Table chat_rooms {
  room_id integer [pk]
  name varchar
}

Table chat_participants {
  room_id integer [ref: > chat_rooms.room_id]
  user_id integer [ref: > users.user_id]
  joined_at datetime [default: `now()`]
  primary key (room_id, user_id)
}

Table chat_messages {
  message_id integer [pk]
  room_id integer [ref: > chat_rooms.room_id]
  user_id integer [ref: > users.user_id]
  text text
  file_path varchar
  created_at datetime [default: `now()`]
}

Table notifications {
  notification_id integer [pk]
  user_id integer [ref: > users.user_id]
  type varchar
  text varchar
  created_at datetime [default: `now()`]
  is_read boolean [default: false]
}